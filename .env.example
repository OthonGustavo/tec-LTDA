# Copie este arquivo para `.env` (cp .env.example .env) e preencha a APP_KEY.
# Gere a chave com: node ace generate:key

# Fuso horário usado pela aplicação e pelas datas gravadas no banco.
TZ=UTC

# Porta HTTP em que o servidor sobe (padrão: http://localhost:3333).
PORT=3333

# Endereço em que o servidor escuta (use 0.0.0.0 para aceitar conexões externas).
HOST=localhost

# Nível de detalhe dos logs: fatal, error, warn, info, debug ou trace.
LOG_LEVEL=info

# Chave secreta que assina cookies e criptografa a sessão. NUNCA versione a real.
# Gere a sua com: node ace generate:key
APP_KEY=

# Ambiente de execução: development, production ou test.
NODE_ENV=development

# Onde a sessão fica guardada. `cookie` não exige nenhum serviço externo.
SESSION_DRIVER=cookie
