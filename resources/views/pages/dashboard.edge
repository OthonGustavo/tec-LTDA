      <p class="text-sm font-medium text-slate-500">Receita ganha</p>
      <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
        {{ new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(Number(wonValue)) }}
      </p>
      <p class="mt-1 text-xs text-slate-500">
        Perdido: {{ new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(Number(lostValue)) }}
      </p>
