        <h2 class="text-sm font-semibold text-slate-900">Últimos clientes</h2>
        <a
          href="{{ route('customers.index') }}"
          class="text-sm font-medium text-blue-600 hover:text-blue-700"
        >Ver todos</a>
      </div>

      @if(recentCustomers.length > 0)
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
              <tr>
                <th class="px-5 py-3 text-left">Cliente</th>
                <th class="px-5 py-3 text-left">Status</th>
                <th class="px-5 py-3 text-center">Oport.</th>
                <th class="px-5 py-3 text-right">Cadastro</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              @each(c in recentCustomers)
                <tr class="hover:bg-slate-50">
                  <td class="px-5 py-3">
                    <a
                      href="{{ route('customers.show', { id: c.id }) }}"
                      class="font-medium text-slate-900 hover:text-blue-700"
                    >{{ c.name }}</a>
                    @if(c.company)
                      <p class="text-xs text-slate-500">{{ c.company }}</p>
                    @end
                  </td>
                  <td class="px-5 py-3">
                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset {{ statusClasses[c.status] }}">
                      {{ statusLabels[c.status] }}
                    </span>
                  </td>
                  <td class="px-5 py-3 text-center text-slate-600">{{ Number(c.$extras.opportunities_count || 0) }}</td>
                  <td class="px-5 py-3 text-right text-slate-500">{{ c.createdAt.setLocale('pt-BR').toFormat('dd/MM/yyyy') }}</td>
                </tr>
              @end
            </tbody>
          </table>
        </div>
      @else
        <div class="px-5 py-10 text-center">
          <p class="text-sm font-medium text-slate-900">Nenhum cliente cadastrado ainda</p>
          <p class="mt-1 text-sm text-slate-500">Cadastre o primeiro cliente para começar a acompanhar o funil.</p>
          <a
            href="{{ route('customers.create') }}"
            class="mt-4 inline-flex items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700"
          >Novo cliente</a>
        </div>
      @end
    </div>

    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
