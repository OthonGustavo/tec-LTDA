        <h2 class="text-sm font-semibold text-slate-900">Atividade recente</h2>
      </div>

      @if(recentInteractions.length > 0)
        <ul class="divide-y divide-slate-100">
          @each(interaction in recentInteractions)
            <li class="px-5 py-4">
              <p class="line-clamp-2 text-sm text-slate-700">{{ interaction.note }}</p>
              <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-slate-500">
                <a
                  href="{{ route('customers.show', { id: interaction.customerId }) }}"
                  class="font-medium text-blue-600 hover:text-blue-700"
                >{{ interaction.customer ? interaction.customer.name : 'Cliente removido' }}</a>
                <span aria-hidden="true">·</span>
                <span>{{ interaction.user ? (interaction.user.fullName || interaction.user.email) : 'Usuário removido' }}</span>
                <span aria-hidden="true">·</span>
                <span>{{ interaction.createdAt.setLocale('pt-BR').toFormat('dd/MM/yyyy HH:mm') }}</span>
              </div>
            </li>
          @end
        </ul>
      @else
        <div class="px-5 py-10 text-center">
          <p class="text-sm font-medium text-slate-900">Nenhuma anotação registrada</p>
          <p class="mt-1 text-sm text-slate-500">As interações lançadas na ficha dos clientes aparecem aqui.</p>
        </div>
      @end
    </div>
  </div>
